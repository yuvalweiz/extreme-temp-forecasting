__pycache__/
*.pyc
*.pt
*.pth
.ipynb_checkpoints/
.DS_Store

# experiment outputs (regenerated by the pipeline)
experiments_real/
experiments_cold/
runs/
slurm_real/
*.out

# data-release contents (large; distributed separately — see README § 2.2).
# Small metadata under data/ (published_predictions, dataset_meta, grid/station
# metadata, raw_ims README stub) stays tracked.
data/stationvec_*/
data/interp_weights/
data/raw_ims/*
!data/raw_ims/README.md

# small precomputed pipeline assets that must ship (exceptions to nothing now,
# kept explicit in case a global *.npy/*.npz ignore returns)
!src/pipeline/geo_channels.npy
!src/pipeline/lapse_correction.npy
!src/pipeline/lapse_norm.npz
!data/grid_metadata.npz
!data/dataset_meta/**
